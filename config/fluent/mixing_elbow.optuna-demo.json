{
  "schema_version": 1,
  "task_name": "AutoFluentOptunaDemoV01",
  "connection": {
    "endpoint": "http://127.0.0.1:18000/mcp",
    "baseline_sha256": "8145813f50f989a521ed8d1b02c891c7ca22ccc5fafa35a4eeba011949f19cbc",
    "client_timeout_seconds": 600,
    "reuse_existing_session": false,
    "disconnect_on_exit": true,
    "connect_kwargs": {
      "ui_mode": "no_gui",
      "precision": "double",
      "processor_count": 2,
      "dimension": 3,
      "case_file_name": "${FLUENT_CASE_FILE}",
      "start_timeout": 180,
      "cleanup_on_exit": true
    }
  },
  "solver": {
    "initialization": "hybrid",
    "iterations": 100,
    "residual_thresholds": {}
  },
  "parameters": [
    {
      "name": "cold_inlet_velocity",
      "collection_path": "setup.boundary_conditions.velocity_inlet",
      "object_name": "cold-inlet",
      "property_path": "momentum.velocity_magnitude.value",
      "unit": "m/s",
      "minimum": 0.4,
      "maximum": 1.1
    }
  ],
  "reports": [
    {
      "name": "outlet-temp-avg",
      "kind": "surface",
      "report_type": "surface-areaavg",
      "field": "temperature",
      "locations": ["outlet"]
    },
    {
      "name": "mass-flow-in",
      "kind": "flux",
      "locations": ["cold-inlet", "hot-inlet"]
    },
    {
      "name": "mass-flow-out",
      "kind": "flux",
      "locations": ["outlet"]
    }
  ],
  "design_points": [
    {
      "name": "baseline",
      "values": {"cold_inlet_velocity": 0.55}
    }
  ],
  "objective": {
    "report": "outlet-temp-avg",
    "direction": "minimize"
  },
  "constraints": [],
  "optimization": {
    "study_name": "fluent_demo_v01",
    "target_trials": 6,
    "sampler_seed": 42,
    "n_startup_trials": 2,
    "mass_flow_in_report": "mass-flow-in",
    "mass_flow_out_report": "mass-flow-out",
    "mass_balance_relative_tolerance": 0.001,
    "mass_balance_epsilon": 1e-12,
    "verify_invalid_parameter_gate": true
  }
}
